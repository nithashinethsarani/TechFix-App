<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_dark">

    <EditText
        android:id="@+id/etTechName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Technician Name"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_secondary"
        android:backgroundTint="@color/text_secondary" />

    <EditText
        android:id="@+id/etSpecialization"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Specialization (e.g. Mobile, Laptop)"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_secondary"
        android:backgroundTint="@color/text_secondary" />

    <EditText
        android:id="@+id/etTechPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Phone Number"
        android:inputType="phone"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_secondary"
        android:backgroundTint="@color/text_secondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Assign Branch"
        android:textColor="@color/text_white" />

    <Spinner
        android:id="@+id/spinnerBranch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:popupBackground="@color/card_bg" />

    <CheckBox
        android:id="@+id/cbTechAvailable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Technician Available"
        android:checked="false" />

    <Button
        android:id="@+id/btnSaveTechnician"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Save Technician"
        android:backgroundTint="@color/white"
        android:textColor="@color/bg_dark" />

</LinearLayout>